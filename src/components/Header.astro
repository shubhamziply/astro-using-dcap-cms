---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="8" fill="var(--color-accent)" />
        <path d="M8 20L14 8L20 20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 16H18" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="logo-text">AstroBlog</span>
    </a>

    <nav class="nav">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { 'nav-link--active': currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
        >
          {link.label}
        </a>
      ))}
      <a href="/admin/" class="btn btn--outline btn--sm" target="_blank" rel="noopener">
        CMS Admin ↗
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(15, 15, 19, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-heading);
  }

  .logo:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .logo-text {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text);
    text-decoration: none;
    opacity: 1;
  }

  .nav-link--active {
    color: var(--color-accent);
  }

  .btn--sm {
    padding: 0.4em 0.9em;
    font-size: 0.8rem;
  }
</style>
