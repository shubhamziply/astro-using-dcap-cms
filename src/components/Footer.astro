---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">
      &copy; {year} AstroBlog. Built with
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      &amp; <a href="https://decapcms.org" target="_blank" rel="noopener">Decap CMS</a>.
    </p>
    <nav class="footer-nav">
      <a href="/blog">Blog</a>
      <a href="/admin/" target="_blank" rel="noopener">Admin</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 0;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-copy a {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .footer-copy a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .footer-nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-nav a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
    opacity: 1;
    text-decoration: none;
  }
</style>
