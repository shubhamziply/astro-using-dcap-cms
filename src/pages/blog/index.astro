---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.date.getTime() - a.data.date.getTime(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="Blog — AstroBlog"
  description="All posts from AstroBlog. Thoughts on Astro, Decap CMS, and modern web development."
>
  <div class="container">
    <header class="page-header">
      <h1>Blog</h1>
      <p class="page-sub">{posts.length} post{posts.length !== 1 ? "s" : ""}</p>
    </header>

    {allTags.length > 0 && (
      <nav class="tags-nav" aria-label="Filter by tag">
        {allTags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </nav>
    )}

    {posts.length === 0 ? (
      <div class="empty-state">
        <p>No posts yet. <a href="/admin/" target="_blank" rel="noopener">Open the CMS admin</a> to create your first post.</p>
      </div>
    ) : (
      <div class="posts-grid">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            date={post.data.date}
            author={post.data.author}
            tags={post.data.tags}
            thumbnail={post.data.thumbnail}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .page-header h1 {
    margin: 0;
  }

  .page-sub {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .tags-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .empty-state a {
    font-weight: 600;
  }
</style>
